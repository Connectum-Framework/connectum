{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4,
    "includes": ["**", "!**/node_modules", "!**/gen", "!**/gen-ts", "!**/*.test.*", "!**/tsconfig*.json"],
    "lineWidth": 180
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "lineEnding": "lf",
      "lineWidth": 180
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "lineWidth": 180,
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "includes": ["**", "!**/node_modules", "!**/gen", "!**/gen-ts", "!**/*.test.*", "!**/tsconfig*.json"],
    "rules": {
      "correctness": {
        "noUnusedVariables": {
          "level": "warn"
        },
        "noUnusedFunctionParameters": {
          "level": "warn"
        },
        "useImportExtensions": {
          "level": "warn",
          "fix": "none"
        },
        "noPrivateImports": "error",
        "noUnusedInstantiation": "error"
      },
      "preset": "recommended",
      "complexity": {},
      "performance": {
        "noReExportAll": "error",
        "noNamespaceImport": "error"
      },
      "security": {},
      "suspicious": {
        "noConsole": {
          "options": {
            "allow": ["debug", "log", "error", "info", "warn", "time", "timeEnd"]
          },
          "level": "warn"
        },
        "noImportCycles": "error",
        "noNestedPromises": "error",
        "noUnassignedVariables": "error",
        "useErrorMessage": "error",
        "noVar": "error",
        "noForIn": "error",
        "useGuardForIn": "error",
        "noReturnAssign": "error",
        "noConstantBinaryExpressions": "error",
        "noDeprecatedImports": "error",
        "noDuplicateDependencies": "error",
        "noBitwiseOperators": "error",
        "noUnusedExpressions": "error",
        "noEqualsToNull": "error"
      }
    }
  },
  "plugins": [
    {
      "path": "./lint/no-direct-router-transport.grit",
      "includes": ["**/packages/*/src/**/*.ts", "!**/packages/core/src/localTransport.ts", "!**/packages/testing/src/mockResolver.ts"]
    }
  ],
  "overrides": [
    {
      "includes": ["**/packages/*/src/**", "**/packages/*/tests/interop/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  }
}
