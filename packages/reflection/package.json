{
  "name": "@connectum/reflection",
  "version": "1.2.0",
  "description": "gRPC Server Reflection protocol for Connectum (v1 + v1alpha)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#gen/*": "./gen/*",
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "gen",
    "proto"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Connectum-Framework/connectum.git",
    "directory": "packages/reflection"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "buf:generate": "buf generate",
    "buf:lint": "buf lint",
    "build:proto": "pnpm run buf:generate && pnpm run build:proto:compile",
    "build:proto:compile": "tsc --project tsconfig.build.json",
    "gen:fixtures": "buf generate tests/fixtures --template tests/fixtures/buf.gen.yaml && biome check --write tests/fixtures",
    "typecheck": "tsc --noEmit",
    "test": "exodus-test --typescript tests/**/*.test.ts",
    "test:unit": "exodus-test --typescript tests/unit/**/*.test.ts",
    "test:integration": "exodus-test --typescript tests/integration/**/*.test.ts",
    "test:bun": "exodus-test --engine bun:pure tests/**/*.test.ts",
    "test:esbuild": "exodus-test --esbuild tests/**/*.test.ts",
    "lint": "biome check src",
    "format": "biome check --write src",
    "build": "tsup",
    "clean": "rm -rf coverage dist gen gen-ts",
    "test:interop": "exodus-test --typescript tests/interop/*.interop.ts"
  },
  "keywords": [
    "reflection",
    "grpc",
    "connectrpc",
    "connectum",
    "server-reflection"
  ],
  "author": "Highload.Zone",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectum/core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@connectum/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@bufbuild/buf": "catalog:",
    "@bufbuild/protobuf": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-node": "catalog:",
    "@connectum/core": "workspace:^",
    "@connectum/healthcheck": "workspace:^",
    "c8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
