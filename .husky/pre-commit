#!/bin/sh
set -eu

if git status --short | grep --quiet '^MM'; then
  printf '%s\n' "ERROR: Some staged files have unstaged changes" >&2
  exit 1;
fi

# Biome judges the biome-ignore suppressions against the generated sources: without
# gen/ it cannot resolve them and reports them as unused.
pnpm exec turbo run build:proto
pnpm run biome

git update-index --again

